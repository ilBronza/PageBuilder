{
  "name": "ilbronza/pagebuilder",
  "description": "Embeddable UIkit page builder with shared Laravel templates and explicit content areas",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "illuminate/support": "^11.0",
    "illuminate/database": "^11.0",
    "illuminate/http": "^11.0",
    "illuminate/routing": "^11.0",
    "illuminate/validation": "^11.0",
    "illuminate/auth": "^11.0",
    "illuminate/view": "^11.0"
  },
  "require-dev": {
    "orchestra/testbench": "^9.0",
    "phpunit/phpunit": "^11.0"
  },
  "suggest": {
    "ilbronza/filecabinet": "Optional read-only adapter for declared dossier fields"
  },
  "autoload": {
    "psr-4": {
      "IlBronza\\PageBuilder\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "IlBronza\\PageBuilder\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "IlBronza\\PageBuilder\\PageBuilderServiceProvider"
      ]
    }
  },
  "scripts": {
    "test": "phpunit"
  }
}
