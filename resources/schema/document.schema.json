        "children": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/heading"
              },
              {
                "$ref": "#/$defs/text"
              },
              {
                "$ref": "#/$defs/image"
              },
              {
                "$ref": "#/$defs/button"
