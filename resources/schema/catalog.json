      "title": {
        "kind": "string",
        "default": "Immagine e testo",
        "binding": "text"
      },
      "text": {
        "kind": "string",
        "default": "Un’immagine accompagnata dal suo contenuto.",
        "binding": "text"
      },
      "src": {
        "kind": "url",
        "default": "",
        "binding": "image"
      },
      "alt": {
        "kind": "string",
        "default": "",
        "binding": "text"
      },
      "position": {
        "kind": "enum",
        "values": [
          "left",
          "right"
        ],
        "default": "left"
      }
    },
    "styles": [
      "background",
      "color",
      "align",
      "margin",
      "padding",
      "fontSize",
      "fontWeight",
      "radius",
      "border",
      "shadow",
      "maxWidth"
    ]
