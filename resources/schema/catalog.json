        "binding": "text"
      },
      "src": {
        "kind": "url",
        "default": "",
        "binding": "image"
      },
      "alt": {
        "kind": "string",
        "default": "",
        "binding": "text"
      },
      "href": {
        "kind": "url",
        "default": "",
        "binding": "url"
      },
      "linkText": {
        "kind": "string",
        "default": "Scopri di più",
        "binding": "text"
      }
    },
    "styles": [
      "background",
      "color",
      "align",
      "margin",
      "padding",
      "fontSize",
      "fontWeight",
      "radius",
      "border",
      "shadow",
      "maxWidth"
    ]
  },
  "icon": {
    "label": "Icona",
    "icon": "☆",
    "props": {
      "icon": {
        "kind": "enum",
        "values": [
          "star",
          "check",
          "heart",
          "info",
          "calendar",
          "location",
          "mail",
          "phone"
        ],
        "default": "star"
      },
      "label": {
        "kind": "string",
        "default": "",
        "binding": "text"
      }
    },
    "styles": [
      "background",
      "color",
      "align",
      "margin",
      "padding",
      "fontSize",
      "fontWeight",
      "radius",
      "border",
      "shadow",
      "maxWidth"
    ]
  },
  "table": {
    "label": "Tabella",
    "icon": "▦",
    "props": {
      "columns": {
        "kind": "list",
        "default": [
          "Voce",
          "Dettaglio"
        ]
      },
      "rows": {
        "kind": "table",
        "default": [
          [
            "Prima voce",
            "Descrizione"
          ],
          [
            "Seconda voce",
            "Descrizione"
          ]
        ]
      }
    },
    "styles": [
      "background",
      "color",
      "align",
      "margin",
      "padding",
      "fontSize",
      "fontWeight",
      "radius",
      "border",
      "shadow",
      "maxWidth"
